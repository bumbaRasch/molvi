{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "molvi",
  "version": "0.1.0",
  "identifier": "com.molvi.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "molvi",
        "width": 880,
        "height": 640,
        "minWidth": 880,
        "maxWidth": 880,
        "minHeight": 640,
        "maxHeight": 640,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "molvi",
        "url": "overlay.html",
        "width": 720,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "visible": false,
        "center": false
      },
      {
        "label": "onboarding",
        "title": "molvi",
        "url": "onboarding.html",
        "width": 720,
        "height": 480,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'unsafe-inline' 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": ["libasound2"]
      },
      "rpm": {
        "depends": ["alsa-lib"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDRDlEMjJGNDFBQzhEQTcKUldTbmpheEJMOUxaekRxa3haL2VDL3czMUk2TUNIVnhybzNOc1p1Wlh0dWo1bUNHRkxZR2ZvQ3kK",
      "endpoints": [
        "https://github.com/bumbaRasch/molvi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
